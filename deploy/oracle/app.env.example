# Nur DG-MAIN-Werte (Supabase dessavbytgxyygeohjrn). Niemals Werte einer anderen Instanz eintragen.
DATABASE_URL=
# DB_CUTOVER=1 und NEW_DATABASE_URL=  (nur nach der Datenbank-Umstellung)
# Admin-Login, CloudTalk usw. aus dem Vercel-Projekt digitalegewinner-outbound übernehmen.

# --- Anreicherungs-Worker (alle optional, fehlende Module werden übersprungen) ---
META_ACCESS_TOKEN=          # APP-ID|APP-SECRET, Identität bei Meta bestätigt (Ad Library API)
TINYFISH_API_KEY=           # agent.tinyfish.ai/api-keys: Browser-Agent für Social und Google Ads (hat Vorrang)
TINYFISH_DAILY_LIMIT=150    # max. Agent-Läufe pro Tag (Kostenbremse)
SERPAPI_KEY=                # Google Ads Transparency Center über SerpAPI
SOCIAL_SCRAPER_URL=         # Scraping-Anbieter für Social-Profile (POST {url,network} -> JSON)
SOCIAL_SCRAPER_KEY=
LEARN_APPLY=1               # 0 = nur Statistik, keine Boosts in metadata.learned_boost
