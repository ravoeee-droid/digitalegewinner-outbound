# Minimal bootstrap: these secrets belong in Vercel/host environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/energy_radar
ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
NEXT_PUBLIC_APP_URL=https://energy-radar.example.com
CRON_SECRET=replace-with-random-32-char-secret
WEBHOOK_SECRET=replace-with-random-webhook-secret
OPENAI_MODEL=gpt-5

# Everything below can ALSO be entered later through the encrypted API Vault in EnergyRadar.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
EMAIL_VERIFIER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional fallback. Prefer the encrypted API Vault.
# Gmail/Microsoft: use refreshToken for long-running OAuth access.
# SMTP: host/user/pass. IDs must match the Mailbox Credential-ID in the UI.
MAILBOX_CREDENTIALS_JSON=[{"id":"mb-andreas","provider":"gmail","email":"andreas@example.com","name":"Andreas","refreshToken":"..."},{"id":"mb-sales","provider":"smtp","email":"sales@example.com","name":"Sales","smtpHost":"smtp.example.com","smtpPort":587,"smtpUser":"sales@example.com","smtpPass":"..."}]
