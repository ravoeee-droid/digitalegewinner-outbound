# Pflege Recruiting Outbound OS — production bootstrap
# Copy to your hosting provider / Vercel environment variables.
# Never commit real passwords, tokens, API keys or mailbox credentials.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pflege_outbound
ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
NEXT_PUBLIC_APP_URL=https://outbound.example.com
CRON_SECRET=replace-with-random-32-char-secret
WEBHOOK_SECRET=replace-with-random-webhook-secret
OPENAI_MODEL=gpt-5

# Optional capabilities. These can also be entered later through the encrypted API Vault.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
EMAIL_VERIFIER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
VIDEO_RENDERER_URL=
VIDEO_RENDERER_SECRET=

# Optional fallback. Prefer OAuth + encrypted API Vault.
# Gmail/Microsoft: use a refreshToken for long-running access.
# SMTP: host/user/pass. IDs must exactly match the Mailbox Credential-ID in the UI.
MAILBOX_CREDENTIALS_JSON=[{"id":"mb-main","provider":"gmail","email":"name@example.com","name":"Vorname Nachname","refreshToken":"..."},{"id":"mb-sales","provider":"smtp","email":"sales@example.com","name":"Sales","smtpHost":"smtp.example.com","smtpPort":587,"smtpUser":"sales@example.com","smtpPass":"..."}]
