# Digitale Gewinner Outbound OS — production bootstrap
# Put these values in Vercel/host environment variables. Never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/digitalegewinner_outbound
ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
NEXT_PUBLIC_APP_URL=https://outbound.example.com
CRON_SECRET=replace-with-random-32-char-secret
WEBHOOK_SECRET=replace-with-random-webhook-secret
OPENAI_MODEL=gpt-5

# SEO Radar — search volume / CPC / SERP data
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenOutreach sidecar + LinkedIn worker
# Keep the GPLv3/OpenOutreach service separate from this Next.js app and connect it over HTTP.
OPENOUTREACH_WORKER_URL=
OPENOUTREACH_WORKER_SECRET=
LINKEDIN_AGENT_WORKER_URL=
LINKEDIN_AGENT_WORKER_SECRET=
# false = queue actions in the worker for review; true = worker may execute its configured paced send flow.
LINKEDIN_AGENT_AUTO_SEND=false

# Scrapling website enrichment worker
SCRAPLING_WORKER_URL=
SCRAPLING_WORKER_SECRET=

# Voice AI abstraction. CloudTalk is the fastest path with the current phone stack.
# Set to pipecat when a Pipecat worker + supported telephony transport is deployed.
VOICE_AGENT_PROVIDER=cloudtalk
CLOUDTALK_API_KEY_ID=
CLOUDTALK_API_KEY=
CLOUDTALK_VOICE_AGENT_ID=
PIPECAT_WORKER_URL=
PIPECAT_WORKER_SECRET=

# These can also be entered later through the encrypted API Vault.
OPENAI_API_KEY=
GOOGLE_MAPS_API_KEY=
EMAIL_VERIFIER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
VIDEO_RENDERER_URL=
VIDEO_RENDERER_SECRET=

# Optional fallback. Prefer OAuth + encrypted API Vault.
# Gmail/Microsoft: use a refreshToken for long-running access.
# SMTP: host/user/pass. IDs must exactly match the Mailbox Credential-ID in the UI.
MAILBOX_CREDENTIALS_JSON=[{"id":"mb-raphael","provider":"gmail","email":"raphael@example.com","name":"Raphael","refreshToken":"..."},{"id":"mb-sales","provider":"smtp","email":"sales@example.com","name":"Sales","smtpHost":"smtp.example.com","smtpPort":587,"smtpUser":"sales@example.com","smtpPass":"..."}]
