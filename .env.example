# Digitale Gewinner Outbound OS — production bootstrap
# Put these values in Vercel/host environment variables. Never commit real secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/digitalegewinner_outbound
ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ENCRYPTION_KEY=replace-with-an-independent-long-random-secret
NEXT_PUBLIC_APP_URL=https://outbound.example.com
CRON_SECRET=replace-with-random-32-char-secret
WEBHOOK_SECRET=replace-with-random-webhook-secret

# DG Core AI router. Prefer entering real keys through the encrypted API Vault.
EXPLABS_API_KEY=
GROQ_API_KEY=
EXPERIENTIAL_MODEL_FAST=deepseek-v4-flash
EXPERIENTIAL_MODEL_SMART=gpt-5.6-luna
EXPERIENTIAL_MODEL_VISION=qwen3.8-27b
GROQ_AGENT_MODEL=openai/gpt-oss-120b
# qwen3.8-27b is currently not a free route. Keep false unless you intentionally enable paid vision routing.
DG_AGENT_ALLOW_PAID_VISION=false

# Optional legacy/premium direct OpenAI route
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# SEO Radar — search volume / CPC / SERP data
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenOutreach sidecar + LinkedIn worker
OPENOUTREACH_WORKER_URL=
OPENOUTREACH_WORKER_SECRET=
LINKEDIN_AGENT_WORKER_URL=
LINKEDIN_AGENT_WORKER_SECRET=
LINKEDIN_AGENT_AUTO_SEND=false

# These can also be entered later through the encrypted API Vault.
GOOGLE_MAPS_API_KEY=
EMAIL_VERIFIER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
VIDEO_RENDERER_URL=
VIDEO_RENDERER_SECRET=

# Optional fallback. Prefer OAuth + encrypted API Vault.
MAILBOX_CREDENTIALS_JSON=[{"id":"mb-raphael","provider":"gmail","email":"raphael@example.com","name":"Raphael","refreshToken":"..."}]

# Outbound OS V3 staged migration.
# Runtime is normally controlled by outbound_runtime_settings in Postgres.
# Explicit ENV values pin/override the DB control plane for emergency operations.
# off: legacy only | shadow: legacy canonical + best-effort V3 mirror | active: V3 write failures are fatal
OUTBOUND_OS_V3_MODE=off
# off: no permission gate | shadow: evaluate/report only | enforce: block disallowed actions
OUTBOUND_COMPLIANCE_MODE=off
# 0 observe, 1 copilot, 2 safety autopilot, 3 conversation, 4 optimization, 5 autonomous GTM
OUTBOUND_AUTONOMY_LEVEL=2
# off: legacy cron orchestration | shadow: durable workflow mirror | active: durable workflow owns orchestration
OUTBOUND_DURABLE_WORKFLOWS_MODE=off
# Emergency infrastructure override. true forces V3/workflows off and autonomy L0.
OUTBOUND_EMERGENCY_KILL_SWITCH=false
