# Core
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/energy_radar
NEXT_PUBLIC_APP_URL=https://energy-radar.example.com
CRON_SECRET=replace-with-random-32-char-secret
WEBHOOK_SECRET=replace-with-random-webhook-secret

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optional enrichment / maps
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
EMAIL_VERIFIER_API_KEY=

# Optional OAuth app credentials (if using delegated OAuth flows)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mailbox credentials are server-side only.
# Gmail/Microsoft entries use an accessToken; SMTP entries use host/user/pass.
# The id MUST match the Credential-ID created in the EnergyRadar Mailboxes UI.
MAILBOX_CREDENTIALS_JSON=[{"id":"mb-andreas","provider":"gmail","email":"andreas@example.com","name":"Andreas","accessToken":"..."},{"id":"mb-sales","provider":"smtp","email":"sales@example.com","name":"Sales","smtpHost":"smtp.example.com","smtpPort":587,"smtpUser":"sales@example.com","smtpPass":"..."}]
